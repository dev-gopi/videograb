# Copy values to your shell environment (no dotenv dependency required).
VIDEOGRAB_DATA_DIR=/home/you/.videograb
VIDEOGRAB_OUTPUT_DIR=/home/you/Downloads/VideoGrab
# 4 GiB by default:
VIDEOGRAB_MAX_BYTES=4294967296
# Set to false to disable browser inspection even if selected in UI:
VIDEOGRAB_BROWSER=true
# Unsafe for an exposed service. Only for trusted localhost test fixtures.
VIDEOGRAB_ALLOW_PRIVATE=false
